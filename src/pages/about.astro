---
import experiences from "../collections/experiences.json";
import AboutExperience from "../components/about-experience.astro";
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="About Me">
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="About Me"
      description="Hello 👋 I'm Hao (Howard) Hoang, a Senior AI Researcher & Engineer. I specialize in LLM systems, AI engineering, agentic workflows, and real-world machine learning applications."
    />

    <img src="/assets/images/about.jpg" class="relative z-30 w-full my-10 rounded-xl" />

    <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">About</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      Daily insights on LLM systems, AI engineering, agentic workflows, and real-world machine learning.
    </p>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      I write about:
    </p>
    <ul
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4 list-disc list-inside space-y-2"
    >
      <li>AI interview questions (LLM engineering, system design, research)</li>
      <li>LLM infrastructure & optimization</li>
      <li>RAG architectures (GraphRAG, Agentic RAG, Hybrid)</li>
      <li>Vision-Language Models (VLMs)</li>
      <li>AI research papers explained simply</li>
      <li>Building and deploying AI products at scale</li>
    </ul>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      My work focuses on the intersection of research and engineering, turning cutting-edge papers into production-ready AI systems.
    </p>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      I help:
    </p>
    <ul
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4 list-disc list-inside space-y-2"
    >
      <li>✔ AI engineers understand complex concepts</li>
      <li>✔ Teams build scalable, reliable LLM systems</li>
      <li>✔ Students and developers break into AI</li>
      <li>✔ Companies turn research into real products</li>
    </ul>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      If you want to level up in AI one day at a time, you're in the right place.
    </p>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg mb-4"
    >
      📬 <a href="https://aiinterviewprep.substack.com/" target="_blank" class="text-indigo-600 underline">AI Interview Prep Newsletter</a>
    </p>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      ☕ <a href="https://buymeacoffee.com/haohoang" target="_blank" class="text-indigo-600 underline">Support my work</a>
    </p>

    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200"
    >
      Experience
    </h2>
    <div class="px-5 py-10">
      {
        experiences.map((experience) => {
          return (
            <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
              <AboutExperience
                dates={experience.dates}
                role={experience.role}
                company={experience.company}
                description={experience.description}
                logo={experience.logo}
              />
            </div>
          )
        })
      }
    </div>

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 dark:text-neutral-200">Let's Connect</h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      🚀 Follow me on <a
        href="https://www.linkedin.com/in/hoang-van-hao/"
        target="_blank"
        class="text-indigo-600 underline">LinkedIn</a
      > (45.8K+ followers), subscribe to my <a
        href="https://aiinterviewprep.substack.com/"
        target="_blank"
        class="text-indigo-600 underline">Substack</a
      > (5.5K+ subscribers), or reach out via email at <a href="mailto:hao.hoang.ai@gmail.com" class="text-indigo-600 underline"
        >email</a
      >. Always open to discussing AI, LLMs, and new opportunities!
    </p>
  </section>
</Layout>
